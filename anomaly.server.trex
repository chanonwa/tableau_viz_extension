<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.custom.anomaly.detection" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Summary statistics and anomaly detection for one or more measures across a category or date.</description>
    <author name="Chanon Wasusopon" email="cwasusopon@gmail.com" organization="Local" website="https://github.com/chanonwa/tableau_viz_extension"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://chanonwa.github.io/tableau_viz_extension/anomaly.html</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="category">
      <display-name>Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Category or date for each data point</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name>Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="10"/>
      <tooltip>Measures to analyse; each gets its own panel</tooltip>
    </encoding>
    <encoding id="breakdown">
      <display-name>Breakdown</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="3"/>
      <tooltip>Dimensions to break the data down by and drill into, in drill order</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Anomaly Detection (GitHub Pages)</text>
    </resource>
  </resources>
</manifest>
