<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.custom.multimeasure.combo" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>A combo chart with multiple measures and configurable bar or line series.</description>
    <author name="Chanon Wasusopon" email="cwasusopon@gmail.com" organization="Local" website="https://github.com/chanonwa/tableau_viz_extension"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8765/index.html</url>
    </source-location>
    <icon/>
    <encoding id="category">
      <display-name>Category</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Category for each data point</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name>Measures</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="50"/>
      <tooltip>One or more measures to show as bars or lines</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Multi-Measure Combo Chart</text>
    </resource>
  </resources>
</manifest>
