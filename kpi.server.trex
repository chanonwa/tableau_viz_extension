<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.custom.kpi.card" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>KPI card with a value, target status, progress bar, change lines, and a trend line.</description>
    <author name="Chanon Wasusopon" email="cwasusopon@gmail.com" organization="Local" website="https://github.com/chanonwa/tableau_viz_extension"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://chanonwa.github.io/tableau_viz_extension/kpi.html</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="value">
      <display-name>Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>The KPI shown as the big number</tooltip>
    </encoding>
    <encoding id="target">
      <display-name>Target</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Optional target; attainment is Value divided by Target unless a field is on Attainment</tooltip>
    </encoding>
    <encoding id="attainment">
      <display-name>Attainment</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Optional attainment rate (1 = 100%) for the status and progress bar</tooltip>
    </encoding>
    <encoding id="change">
      <display-name>Change</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="2"/>
      <tooltip>Up to two changes, such as % vs prior year, shown with a green or red arrow</tooltip>
    </encoding>
    <encoding id="trend">
      <display-name>Trend</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <tooltip>Optional dimension, such as MONTH(Date), for a trend line of the Value</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">KPI Card (GitHub Pages)</text>
    </resource>
  </resources>
</manifest>
